# Copy to .env (never commit .env) and fill in. Real environment variables override this file.

# --- Live demo ---
PACE_S=0.5                     # seconds between messages so the audience can follow
PRINT_LOG=0                    # 1 = also print every message to the terminal

# --- Band (agents post into the trip's Band room) ---
TRANSPORT=local                # local | band
BAND_REST_URL=https://app.band.ai/api/v1
BAND_ROOM_ID=
# One Band agent per role, any order. A traveler is matched to the Advocate named after them
# (e.g. "Léa's Advocate"); others get a free Advocate. `python band.py` shows who is who.
BAND_COORDINATOR_KEY=
BAND_RESEARCHER_KEY=
BAND_ADVOCATE_1_KEY=
BAND_ADVOCATE_2_KEY=
BAND_ADVOCATE_3_KEY=
BAND_ADVOCATE_4_KEY=

# --- Superlinked SIE models + Keenable web search (all optional: without them the mocks/local scorer are used) ---
SUPERLINKED_API_KEY=
KEENABLE_API_KEY=

# --- P2 memory ---
# Team decision: P2 runs without cognee (dict memory saved to data/memory.json).
# Remove this line to turn cognee back on (local, or Cognee Cloud with the two lines below).
MEMORY_BACKEND=dict
# COGNEE_SERVICE_URL=https://tenant-<TENANT_ID>.aws.cognee.ai
# COGNEE_API_KEY=
