# Copy to .env (git-ignored) and fill in. memory.py reads it automatically.
# Cognee Cloud: your tenant is in the URL. Format: https://tenant-<TENANT_ID>.aws.cognee.ai
COGNEE_SERVICE_URL=https://tenant-<TENANT_ID>.aws.cognee.ai
COGNEE_API_KEY=<your Cognee API key>
# Optional: local cognee (no cloud) needs an LLM key for improve()
# LLM_API_KEY=
