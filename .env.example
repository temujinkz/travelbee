# Copy to .env (never commit .env) and fill in. Real environment variables override this file.

# --- Live demo ---
PACE_S=0.5                     # seconds between messages so the audience can follow
PRINT_LOG=0                    # 1 = also print every message to the terminal

# --- Band (agents post into the trip's Band room) ---
TRANSPORT=local                # local | band
BAND_REST_URL=https://app.band.ai/api/v1
BAND_ROOM_ID=
# One Band agent per role, any order. A traveler is matched to the Advocate named after them
# (e.g. "Léa's Advocate"); others get a free Advocate. `python band.py` shows who is who.
BAND_COORDINATOR_KEY=
BAND_RESEARCHER_KEY=
BAND_ADVOCATE_1_KEY=
BAND_ADVOCATE_2_KEY=
BAND_ADVOCATE_3_KEY=
BAND_ADVOCATE_4_KEY=

# --- P2 memory (cognee) ---
# Needs Python >= 3.10 with cognee: python3.12 -m venv .venv && .venv/bin/pip install cognee==1.6.8
# Cognee Cloud = one memory shared by everyone's computer (Coordinator, app, Band Advocates). Tenant id goes in the URL.
COGNEE_SERVICE_URL=https://tenant-<TENANT_ID>.aws.cognee.ai
COGNEE_API_KEY=
# Without the two lines above: local cognee (per computer; improve() then needs LLM_API_KEY).
# MEMORY_BACKEND=dict   forces plain dict memory (no cognee)
# agents/advocates.py (the four Advocates with the Band x Cognee memory adapter) uses the BAND_ADVOCATE_n_KEY
# lines above and the Cognee lines here. Room memory dataset, shared by all four:
# COGNEE_BAND_DATASET=travelbee_rooms
